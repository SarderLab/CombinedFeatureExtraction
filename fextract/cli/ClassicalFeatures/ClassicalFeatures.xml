<?xml version="1.0" encoding="UTF-8"?>
<executable>
  <category>HistomicsTK</category>
  <title>Extract Classical Features</title>
  <description>Extract Pathomic and Extended Clinical Features</description>
  <version>0.1.0</version>
  <documentation-url>https://github.com/SarderLab/Multi-Compartment-Segmentation</documentation-url>
  <license>Apache 2.0</license>
  <contributor>Sayat Mimar (UFL)</contributor>
  <acknowledgements>This work is part of efforts in digital pathology by the Sarder Lab: UFL.</acknowledgements>
  <parameters>
    <label>IO</label>
    <description>Input/output parameters</description>
    <string-enumeration>
      <name>type</name>
      <label>Extraction Type</label>
      <description>Type of Feature Extraxtion: "Pathomic" or "Extended Clinical"</description>
      <default>Pathomic</default>
      <element>Pathomic</element>
      <element>Extended_Clinical</element>
      <index>0</index>
    </string-enumeration>
    <image reference="_girder_id_">
      <name>input_file</name>
      <label>input_file</label>
      <description>input file</description>
      <channel>input</channel>
      <index>1</index>
    </image>
  </parameters>
  <parameters advanced="true">
   <label>Thresholds</label>
   <description>Thresholds for feature extraction</description>
   <integer>
     <name>glom_min_area</name>
     <longflag>glom-min-area</longflag>
     <label>Glomeruli Minimum Area</label>
     <description>Minimum area threshold (pixels) for normal glomeruli</description>
     <default>24000</default>
   </integer>
   <integer>
     <name>sglom_min_area</name>
     <longflag>sglom-min-area</longflag>
     <label>Sclerosed Glomeruli Minimum Area</label>
     <description>Minimum area threshold (pixels) for sclerosed glomeruli</description>
     <default>24000</default>
   </integer>
   <integer>
     <name>tubule_min_area</name>
     <longflag>tubule-min-area</longflag>
     <label>Tubules Minimum Area</label>
     <description>Minimum area threshold (pixels) for tubules</description>
     <default>10</default>
   </integer>
   <integer>
     <name>artery_min_area</name>
     <longflag>artery-min-area</longflag>
     <label>Arteries/Arterioles Minimum Area</label>
     <description>Minimum area threshold (pixels) for artery/arterioles</description>
     <default>10</default>
   </integer>
  </parameters>
  <parameters advanced="true">
    <label>Girder API URL and Key</label>
    <description>A Girder API URL and token for Girder client</description>
    <string>
      <name>girderApiUrl</name>
      <longflag>api-url</longflag>
      <label>Girder API URL</label>
      <description>A Girder API URL (e.g., https://girder.example.com:443/api/v1)</description>
      <default></default>
    </string>
    <string>
      <name>girderToken</name>
      <longflag>token</longflag>
      <label>Girder API Token</label>
      <description>A Girder token</description>
      <default></default>
    </string>
  </parameters>
</executable>